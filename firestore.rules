rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWordId(id) {
      return id is string && id.size() >= 3 && id.size() <= 10 && id.matches('^w(4[1-9]|[5-7][0-9]|80)$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'email', 'totalAnswered', 'totalCorrect',
        'currentStreak', 'bestStreak', 'completedSessions', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'email', 'totalAnswered', 'totalCorrect',
        'currentStreak', 'bestStreak', 'completedSessions', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid == userId && isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
      data.totalAnswered is int && data.totalAnswered >= 0 && data.totalAnswered <= 1000000 &&
      data.totalCorrect is int && data.totalCorrect >= 0 && data.totalCorrect <= data.totalAnswered &&
      data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 1000000 &&
      data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 1000000 &&
      data.completedSessions is list && data.completedSessions.size() <= 10 &&
      (data.completedSessions.size() == 0 || (data.completedSessions[0] is string && data.completedSessions[0].size() <= 40)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidWordProgress(data, userId, wordId) {
      return data.keys().hasAll([
        'userId', 'wordId', 'wordNumber', 'masteryLevel', 'correctCount',
        'wrongCount', 'consecutiveCorrect', 'isWeak', 'isPinned',
        'lastConfusedMeaning', 'lastResult', 'lastStudiedAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'wordId', 'wordNumber', 'masteryLevel', 'correctCount',
        'wrongCount', 'consecutiveCorrect', 'isWeak', 'isPinned',
        'lastConfusedMeaning', 'lastResult', 'lastStudiedAt', 'updatedAt'
      ]) &&
      data.userId is string && data.userId == userId && isValidId(data.userId) &&
      data.wordId is string && data.wordId == wordId && isValidWordId(data.wordId) &&
      data.wordNumber is int && data.wordNumber >= 41 && data.wordNumber <= 80 &&
      data.masteryLevel is int && data.masteryLevel >= 0 && data.masteryLevel <= 5 &&
      data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100000 &&
      data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 100000 &&
      data.consecutiveCorrect is int && data.consecutiveCorrect >= 0 && data.consecutiveCorrect <= 100000 &&
      data.isWeak is bool &&
      data.isPinned is bool &&
      data.lastConfusedMeaning is string && data.lastConfusedMeaning.size() <= 100 &&
      data.lastResult is string && data.lastResult.size() <= 10 &&
      data.lastResult in ['correct', 'wrong', 'unseen'] &&
      data.lastStudiedAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStudySession(data, userId) {
      return data.keys().hasAll([
        'userId', 'sessionId', 'sessionTitle', 'mode', 'totalQuestions',
        'firstTryCorrect', 'requeuedCount', 'durationSeconds', 'mistakenWordIds', 'completedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'sessionId', 'sessionTitle', 'mode', 'totalQuestions',
        'firstTryCorrect', 'requeuedCount', 'durationSeconds', 'mistakenWordIds', 'completedAt'
      ]) &&
      data.userId is string && data.userId == userId && isValidId(data.userId) &&
      data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 40 &&
      data.sessionId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.sessionTitle is string && data.sessionTitle.size() >= 1 && data.sessionTitle.size() <= 100 &&
      data.mode is string && data.mode.size() <= 16 && data.mode in ['standard', 'weakness', 'exam'] &&
      data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100 &&
      data.firstTryCorrect is int && data.firstTryCorrect >= 0 && data.firstTryCorrect <= data.totalQuestions &&
      data.requeuedCount is int && data.requeuedCount >= 0 && data.requeuedCount <= 1000 &&
      data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
      data.mistakenWordIds is list && data.mistakenWordIds.size() <= 40 &&
      (data.mistakenWordIds.size() == 0 || (data.mistakenWordIds[0] is string && data.mistakenWordIds[0].size() <= 10)) &&
      data.completedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      // PII Protection: Strict owner-only single-doc read; directory listing forbidden.
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action: Update learning stats & completed sessions
          incoming().diff(existing()).affectedKeys().hasOnly([
            'totalAnswered', 'totalCorrect', 'currentStreak', 'bestStreak', 'completedSessions', 'updatedAt'
          ]) ||
          // Action: Update display name
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        );

      allow delete: if false;

      // Per-word progress & mistake tracking
      match /wordProgress/{wordId} {
        allow get: if isValidId(userId) && isValidWordId(wordId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidWordId(wordId) &&
          isOwner(userId) &&
          isValidWordProgress(incoming(), userId, wordId) &&
          incoming().lastStudiedAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if isVerified() &&
          isValidId(userId) &&
          isValidWordId(wordId) &&
          isOwner(userId) &&
          isValidWordProgress(incoming(), userId, wordId) &&
          incoming().userId == existing().userId &&
          incoming().wordId == existing().wordId &&
          incoming().wordNumber == existing().wordNumber &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId) && (
            // Action: Record study/quiz attempt
            (
              incoming().lastStudiedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'masteryLevel', 'correctCount', 'wrongCount', 'consecutiveCorrect',
                'isWeak', 'isPinned', 'lastConfusedMeaning', 'lastResult',
                'lastStudiedAt', 'updatedAt'
              ])
            ) ||
            // Action: Toggle weak pin only
            (
              incoming().lastStudiedAt == existing().lastStudiedAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isPinned', 'updatedAt'])
            )
          );

        allow delete: if isVerified() && isValidId(userId) && isValidWordId(wordId) && isOwner(userId);
      }

      // Immutable study session logs
      match /studySessions/{sessionLogId} {
        allow get: if isValidId(userId) && isValidId(sessionLogId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidId(sessionLogId) &&
          isOwner(userId) &&
          isValidStudySession(incoming(), userId) &&
          incoming().completedAt == request.time &&
          hasValidParentUser(userId);

        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(sessionLogId) && isOwner(userId);
      }
    }
  }
}
